DATABASE_URL="file:../data/consultorio.db"
JWT_SECRET="troque-por-um-valor-aleatorio-e-secreto"
PORTA=3000

# Usados só pelo seed (backend/prisma/seed.ts) para criar o usuário administrador.
# Se deixar em branco, o "npm run setup" pergunta o e-mail e a senha no terminal.
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_SENHA="troque-por-uma-senha-forte"

# --- Variáveis opcionais — normalmente não precisa mexer no uso local ---
#
# PORT: porta em que o servidor escuta. A Railway define essa variável sozinha; não precisa
# mexer. Localmente, quem manda é PORTA (acima).
# PORT=8080
#
# COOKIE_SECURE: exige HTTPS para o cookie de login. Deixe "false" (ou remova) para uso
# local/rede local. Em produção (Railway, atrás de HTTPS) isso já é detectado sozinho pelo
# servidor; só defina "true" aqui se quiser forçar.
# COOKIE_SECURE=true
#
# UPLOADS_DIR: pasta onde ficam as fotos/anexos enviados. Localmente não precisa definir
# (usa backend/uploads automaticamente). Em produção (Railway), aponte para dentro do volume
# persistente (ex.: /data/uploads) — veja docs/DEPLOY-RAILWAY.md — senão as fotos somem a
# cada novo deploy.
# UPLOADS_DIR=/data/uploads
