DATABASE_URL="file:../data/consultorio.db"
JWT_SECRET="troque-por-um-valor-aleatorio-e-secreto"
PORTA=3333

# Usados só pelo seed (backend/prisma/seed.ts) para criar o usuário administrador.
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_SENHA="troque-por-uma-senha-forte"

# --- Variáveis usadas só em produção (ex.: Railway) — deixe como está para uso local ---
#
# PORT: porta em que o servidor escuta. Serviços como o Railway definem essa variável
# sozinhos; não precisa mexer. Localmente, quem manda é PORTA (acima).
# PORT=8080
#
# COOKIE_SECURE: exige HTTPS para o cookie de login. Deixe "false" (ou remova) localmente;
# em produção com HTTPS (Railway), defina como "true".
# COOKIE_SECURE=true
#
# UPLOADS_DIR: pasta onde ficam as fotos/anexos enviados. Localmente não precisa definir
# (usa backend/uploads automaticamente). Em produção, aponte para dentro do armazenamento
# persistente (ex.: o volume do Railway), senão os arquivos somem a cada novo deploy.
# UPLOADS_DIR=/data/uploads
