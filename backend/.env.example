DATABASE_URL="file:../data/consultorio.db"
JWT_SECRET="troque-por-um-valor-aleatorio-e-secreto"
PORTA=3000

# Usados só pelo seed (backend/prisma/seed.ts) para criar o usuário administrador.
# Se deixar em branco, o "npm run setup" pergunta o e-mail e a senha no terminal.
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_SENHA="troque-por-uma-senha-forte"

# --- Variáveis opcionais — normalmente não precisa mexer no uso local ---
#
# COOKIE_SECURE: exige HTTPS para o cookie de login. Deixe "false" (ou remova) para uso
# local/rede local. Se for publicar com Cloudflare Tunnel (HTTPS de ponta a ponta até o
# navegador), pode definir como "true".
# COOKIE_SECURE=true
#
# UPLOADS_DIR: pasta onde ficam as fotos/anexos enviados. Não precisa definir — usa
# backend/uploads automaticamente.
# UPLOADS_DIR=/caminho/opcional
