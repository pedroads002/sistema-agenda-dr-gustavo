node_modules/

# Banco de dados (arquivo local, não deve ir para o Git)
*.db
*.db-journal
backend/data/

# Uploads (fotos, termos assinados) — dados sensíveis, ficam só na máquina
backend/src/uploads/
backend/uploads/

# Variáveis de ambiente (segredos: chave do JWT, etc.)
.env
.env.*
!.env.example

# Builds
dist/
build/
frontend/dist/
backend/dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Sistema operacional
.DS_Store

# Editores
.vscode/
.idea/

# Configurações e estado locais do Claude Code (específicas desta máquina)
.claude/settings.local.json
.claude/scheduled_tasks.lock
